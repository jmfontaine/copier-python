{%- set pkg = project_kind == 'package' -%}
{%- set min_minor = python_min.split('.')[1] | int -%}
{%- set max_minor = python_max.split('.')[1] | int -%}
{%- set pythons = [] -%}
{%- for minor in range(min_minor, max_minor + 1) -%}
{%- set _ = pythons.append('"3.' ~ minor ~ '"') -%}
{%- endfor -%}
{%- set edges = [python_min] if python_min == python_max else [python_min, python_max] -%}
name: CI

on:
  push:
    branches: [main]
  pull_request:
{%- if pkg %}
  # The publish workflow runs every check on the tagged commit before releasing.
  workflow_call:
{%- endif %}

permissions:
  contents: read

# A pull request's runs share its ref, so a newer push cancels the older run.
# Every other run gets a group of its own commit, so no `main` commit is left
# without a result: a group holds only one pending run, so even
# `cancel-in-progress: false` would drop the middle one of three quick pushes.
{%- if pkg %}
# github.workflow keeps a release run (called from "Publish") apart from the
# `main` run of the same commit.
{%- endif %}
concurrency:
  group: ci-{% raw %}${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.ref || github.sha }}{% endraw %}
  cancel-in-progress: true

jobs:
  lint:
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@07a047e608db84b3d8c06cd9a7c7dcc9c355c18e  # v10.3.2
        with:
          # Jobs on the same Python otherwise compute the same cache key and
          # race to reserve it, which logs a warning in whichever loses.
          cache-suffix: {% raw %}${{ github.job }}{% endraw %}
      - run: uv sync --locked
      # The one list of checks, shared with `just qa` and the git hooks. Hooks
      # that fix files fail here when they change something, and the diff shows
      # what they changed.
      - run: uv run pre-commit run --all-files --show-diff-on-failure
{%- if pkg %}
      - name: Verify public API type completeness
        run: uv run pyright --ignoreexternal --verifytypes {{ package_name }}
{%- endif %}
{%- if pkg %}

  test:
    runs-on: ubuntu-26.04
    strategy:
      fail-fast: false
      matrix:
        python: [{{ pythons | join(', ') }}]
        resolution: [highest]
        include:
          # The oldest dependency versions pyproject.toml allows, on the oldest
          # and newest Python. Deprecations are fatal there, so an old
          # dependency calling an API Python deprecates fails here rather than
          # when that API is removed.
{%- for python in edges %}
          - python: "{{ python }}"
            resolution: lowest-direct
            warnings: -W error::DeprecationWarning -W error::PendingDeprecationWarning
{%- endfor %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@07a047e608db84b3d8c06cd9a7c7dcc9c355c18e  # v10.3.2
        with:
{%- raw %}
          python-version: ${{ matrix.python }}
          cache-suffix: ${{ github.job }}-${{ matrix.resolution }}
      # Only the test group, so the suite cannot lean on a dev tool. The
      # lowest-direct resolution rewrites uv.lock in the runner; the highest
      # one installs exactly what uv.lock pins.
      - run: >-
          uv sync --no-dev --group test
          ${{ matrix.resolution == 'lowest-direct' && '--resolution lowest-direct' || '--locked' }}
      # --no-sync: a plain `uv run` would sync the dev group back in, and would
      # re-resolve a lowest-direct lock to the newest versions.
      - run: uv run --no-sync python ${{ matrix.warnings }} -m pytest --cov

  build:
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@07a047e608db84b3d8c06cd9a7c7dcc9c355c18e  # v10.3.2
        with:
          cache-suffix: ${{ github.job }}
      - run: uv build
      - name: Check distribution contents
        run: uv run --no-project python scripts/check_distributions.py dist
      - name: Check distribution metadata
        run: uvx twine check --strict dist/*
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9  # v7.0.2
        with:
          name: dist
          path: dist/
          if-no-files-found: error

  # The tests above run from the source tree. These install what would be
  # published into clean environments, resolving dependencies from the package
  # metadata instead of uv.lock, and test that.
  wheel:
    needs: [build]
    runs-on: ubuntu-26.04
    strategy:
      fail-fast: false
      matrix:
{%- endraw %}
        python: [{% for python in edges %}"{{ python }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{%- raw %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@07a047e608db84b3d8c06cd9a7c7dcc9c355c18e  # v10.3.2
        with:
          python-version: ${{ matrix.python }}
          cache-suffix: ${{ github.job }}
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333  # v8.0.2
        with:
          name: dist
          path: dist/
      - name: Install the wheel with pip
        run: |
          uv venv --python ${{ matrix.python }} --seed /tmp/wheel-env
          /tmp/wheel-env/bin/python -m pip install --quiet dist/*.whl
          /tmp/wheel-env/bin/python -m pip check
      # Before the test group lands, so nothing masks what the wheel resolved.
      - name: Check the installed package
        run: /tmp/wheel-env/bin/python scripts/check_installed_package.py
      - name: Install the test group
        run: |
          uv export --frozen --only-group test --no-hashes --no-emit-project -o /tmp/test-requirements.txt
          /tmp/wheel-env/bin/python -m pip install --quiet -r /tmp/test-requirements.txt
          /tmp/wheel-env/bin/python -m pip check
      - name: Run the test suite against the installed wheel
        run: /tmp/wheel-env/bin/python -m pytest
{%- endraw %}

  sdist:
    needs: [build]
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@07a047e608db84b3d8c06cd9a7c7dcc9c355c18e  # v10.3.2
        with:
          python-version: "{{ python_max }}"
          cache-suffix: {% raw %}${{ github.job }}{% endraw %}
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333  # v8.0.2
        with:
          name: dist
          path: dist/
      - name: Build and install the sdist with pip
        run: |
          uv venv --python {{ python_max }} --seed /tmp/sdist-env
          /tmp/sdist-env/bin/python -m pip install --quiet dist/*.tar.gz
          /tmp/sdist-env/bin/python -m pip check
      - name: Check the installed package
        run: /tmp/sdist-env/bin/python scripts/check_installed_package.py
{%- else %}

  test:
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@07a047e608db84b3d8c06cd9a7c7dcc9c355c18e  # v10.3.2
        with:
          cache-suffix: {% raw %}${{ github.job }}{% endraw %}
      - run: uv sync --locked --no-dev --group test
      - run: uv run --no-sync pytest --cov
{%- endif %}

  # The one check a ruleset requires, so adding or renaming a job never needs a
  # ruleset change. Keep every other job in `needs`. It runs whatever the others
  # did, and fails when one failed or was canceled.
  ci-passed:
    name: CI passed
    needs: [lint, test{% if pkg %}, build, wheel, sdist{% endif %}]
    if: always()
    runs-on: ubuntu-26.04
    steps:
      - name: Fail when a job failed or was canceled
        if: contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled')
        run: exit 1
